  "narrative": {
    "entries": [
      {
        "source_file": "/Users/panyao/Desktop/Biomimetic-design-library/tools/litextract/outputs/extractions/第三波/json/2024-Yuan-tannic-acid-cellulose-aerogel-heavy-metal-chromium.json",
        "paper_id": "2024-Yuan-tannic-acid-cellulose-aerogel-heavy-metal-chromium",
        "sections": {
          "problem_definition": "工业废水中重金属(Cr(VI), Cu(II))和有机染料(CR)毒性高、难降解、易富集；传统纯CNF气凝胶机械强度低、活性位点少、稳定性差；需要构建富含活性位点、结构稳定、可循环的高效三维吸附材料。",
          "biological_solution": "模仿贻贝足丝蛋白的聚多巴胺(PDA)化学和植物单宁酸(TA)的多酚网络：PDA富含邻苯二酚、亚胺、氨基，可强效粘附于蒙脱土表面并提供多元吸附位点；TA作为天然多酚交联剂，通过氢键、Michael加成和席夫碱反应将PMMT和聚乙烯亚胺(PEI)牢固锚定在CNF骨架上，形成致密且高孔隙的蜂窝状三维网络。TA的酚羟基赋予材料电子转移和还原能力，PEI的密集氨基提供正电荷和螯合位点。",
          "key_features": "必须保留：PDA的邻苯二酚/氨基粘附层、TA的多酚交联网络、PEI的氨基官能团、CNF的三维蜂窝骨架。可灵活调整：TA交联密度、PEI接枝量、MMT层间距。",
          "design_mapping": "生物结构→材料设计：贻贝DOPA→PDA涂层改性粘土；植物单宁→TA多酚交联剂；高密度氨基→PEI功能化；蜂窝孔隙→冷冻干燥冰晶模板法。软约束建议：TA与PEI的协同交联是关键，PEI含量过高会堵塞孔隙降低吸附；酸性条件下氨基质子化增强静电吸附，但需平衡TA的还原活性。",
          "explainability_anchors": "仿生故事线：融合贻贝仿生粘附化学(PEI)与植物多酚交联网络(TA)，构建CNF-PMMT-PEI-TA三维蜂窝气凝胶，利用多酚还原+氨基螯合+静电吸引的多重协同机制实现Cr(VI)/Cu(II)/CR的高效捕获与转化。设计溯源：贻贝足丝→PDA→植物单宁→PEI接枝→CNF三维气凝胶→多污染物协同去除。"
        }
      },
      {
        "source_file": "/Users/panyao/Desktop/Biomimetic-design-library/tools/litextract/outputs/extractions/第三波/json/2023-Tan-corrosion-inhibitor-leaves-extract.json",
        "paper_id": "tan2023_dole_corrosion_inhibitor",
        "sections": {
          "problem_definition": "工业酸洗过程中X70管线钢在硫酸介质中面临严重腐蚀问题，传统缓蚀剂多为有毒有机合成物，不符合环保要求。需要开发可生物降解的绿色缓蚀剂。",
          "biological_solution": "降香黄檀（Dalbergia odorifera）叶片含有丰富的黄酮类和多酚类活性成分（DCMB、HMDD、HMPC、HDPC），这些分子含有大量羟基、羰基和共轭π体系，可通过孤对电子与Fe的空d轨道配位形成化学吸附膜，同时范德华力和静电作用贡献物理吸附，实现化学-物理协同吸附保护。",
          "key_features": "必须保留：多羟基和羰基官能团（吸附活性位点）、共轭π体系（提供电子和轨道重叠）。可灵活调整：分子平面性（影响平行吸附覆盖率）、提取溶剂和浓度。",
