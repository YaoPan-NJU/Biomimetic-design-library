  "narrative": {
    "entries": [
      {
        "source_file": "/Users/panyao/Desktop/Biomimetic-design-library/tools/litextract/outputs/extractions/第三波/json/2022-Xu-arsenic-antimony-adsorption-water-treatment.json",
        "paper_id": "xu2022_bacteria_kaolin_fe_mn_sb_as",
        "sections": {
          "problem_definition": "水体中锑（Sb）和砷（As）污染严重威胁生态安全和人类健康，传统化学合成方法制备的Fe-Mn氧化物能耗高、步骤复杂。铁氧化细菌（IOB）能在常温常压下将Fe(II)氧化为Fe(III)，并矿化形成高活性的铁氧化物，同时细菌胞外聚合物提供丰富的有机官能团，是一种绿色、可持续的材料合成策略。",
          "biological_solution": "氧化亚铁硫杆菌（Acidithiobacillus ferrooxidans）在代谢过程中将Fe(II)氧化为Fe(III)，形成的生物成因Fe(III)矿物具有比非生物矿物更大的比表面积、更小的粒径和更低的结晶度。细菌胞外有机质含有羧基、磷酸基、氨基和羟基等官能团，可增强与重金属的配位作用。将Fe-Mn双金属氧化物负载于高岭土基底上，实现多组分协同吸附。",
          "key_features": "必须保留：IOB的生物氧化能力（Fe(II)→Fe(III)）、胞外有机质官能团（-COOH, -OH, -NH₂, -PO₃H₂）、高岭土多孔基底。可灵活调整：Fe/Mn摩尔比（1:0.1最优）、高岭土负载量、IOB培养条件。",
          "design_mapping": "生物过程→材料合成：IOB氧化Fe(II)→生物Fe(III)氧化物→与Mn氧化物共沉淀→负载于高岭土→BKFMs复合材料。仿生设计启示：利用微生物的代谢能力在温和条件下合成高活性金属氧化物，避免高温焙烧，保留生物有机质的配位功能。",
          "explainability_anchors": "仿生故事线：从铁氧化细菌的生物矿化能力出发，利用IOB在常温下将Fe(II)氧化并矿化为高活性Fe(III)氧化物，与Mn氧化物复合负载于高岭土，实现Sb和As的高效同步去除。设计溯源：IOB→生物Fe(III)氧化物→Fe-Mn双金属氧化物→高岭土复合→BKFMs。核心机制：内球络合+表面络合+氢键+氧化。"
        }
      }
    ]
  },
