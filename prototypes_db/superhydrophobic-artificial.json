  "narrative": {
    "entries": [
      {
        "source_file": "/Users/panyao/Desktop/Biomimetic-design-library/tools/litextract/outputs/extractions/专利/json/2022-CN114874407A-超疏水-海绵.json",
        "paper_id": "CN114874407A",
        "sections": {
          "problem_definition": "荷叶表面具有微纳层级粗糙结构和低表面能蜡质层，实现超疏水自清洁效应；水处理中含油废水（如石油泄漏）需要高效油水分离材料，传统海绵亲水亲油无法选择性分离。",
          "biological_solution": "荷叶通过微米级乳突+纳米级蜡质晶体构建层级粗糙结构，降低水滴接触面积，实现Cassie-Baxter态超疏水。进化策略是通过多尺度结构协同实现超浸润特性。",
          "key_features": "必须保留：微米级针状/棒状粒子（类荷叶微米乳突）+ 纳米级球形粒子（类荷叶纳米蜡晶）构建层级粗糙结构；氟硅烷低表面能修饰（类蜡质层）。可灵活调整：粒子种类（TiO2/Al2O3/SiO2）、粒子比例、氟硅烷种类。",
          "design_mapping": "生物结构→材料设计：荷叶微米乳突→微米TiO2晶须；荷叶纳米蜡晶→纳米球形TiO2/Al2O3/SiO2；蜡质低表面能层→氟硅烷修饰。软约束建议：微米:纳米粒子比例5-20:1-10是关键，直接参与交联比后接枝更稳定。",
          "explainability_anchors": "仿生故事线：模仿荷叶表面的微纳层级粗糙结构，用微米TiO2晶须+纳米球形粒子构建人工粗糙面，氟硅烷赋予低表面能，实现超疏水超亲油油水分离。设计溯源：从荷叶→微纳结构→TiO2复合粒子→超疏水海绵。"
        }
      }
    ]
  },
