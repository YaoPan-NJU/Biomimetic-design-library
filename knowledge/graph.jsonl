{"op":"create","id":"context_existing_a2o_low_cn_variability","type":"ProcessContext","properties":{"name":"既有 A²/O 在低 C/N 与进水波动下运行","processes":["A2O"],"problems":["influent_load_variability","low_cn","tn_instability"],"description":"以不大改土建的既有 A²/O 为对象，关注进水负荷波动、低碳氮比和 TN 稳定性。"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"metric_tn_stability","type":"TargetMetric","properties":{"name":"出水 TN 稳定性","description":"出水 TN 的方差、95 分位和超标历时。"},"source":"docs/2026-06-10-vertical-slice-a2o-implementation-plan.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"metric_tp_non_inferiority","type":"TargetMetric","properties":{"name":"除磷不劣性","description":"引入新策略后，出水 TP 表现不劣于最佳现有实践对照。"},"source":"docs/2026-06-10-vertical-slice-a2o-implementation-plan.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"metric_aeration_energy","type":"TargetMetric","properties":{"name":"曝气能耗","description":"由 kLa、风量和功率换算的曝气能耗，不应高于对照。","unit":"kWh/d"},"source":"docs/2026-06-10-vertical-slice-a2o-implementation-plan.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"prototype_microbial_mat","type":"BiologicalPrototype","properties":{"name":"微生物席","category":"microbial_ecosystem","description":"具有氧化还原空间分层和随环境驱动力变化的反应锋面；当前仅作为待核实的仿生原型。","verification_status":"unverified"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"mechanism_redox_zonation","type":"BiologicalMechanism","properties":{"name":"氧化还原分层","description":"通过空间梯度维持相邻但不同的电子受体利用区。","verification_status":"unverified"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"mechanism_adaptive_front_migration","type":"BiologicalMechanism","properties":{"name":"反应锋面自适应迁移","description":"氧化还原边界随负荷与传质条件改变而移动，但速度受到最慢生物过程限制。","verification_status":"unverified"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"mapping_adaptive_redox_front","type":"DesignMapping","properties":{"name":"移动氧化还原锋面的 A²/O 分区自适应映射","summary":"将微生物席的分层与锋面迁移机制转译为 A²/O 可重配分区、曝气和回流控制变量。","applicable_scales":["reactor","system"],"verification_status":"unverified"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"lever_aeration_distribution","type":"EngineeringLever","properties":{"name":"曝气空间分配","retrofit_level":"near_zero","description":"调整各反应区的曝气强度、设定值和启停状态。"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"lever_internal_recycle_routing","type":"EngineeringLever","properties":{"name":"内回流路由","retrofit_level":"minor","description":"切换或调节硝化液回流的取放点，保护真正厌氧区。"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"lever_carbon_dosing_location","type":"EngineeringLever","properties":{"name":"碳源投加位置","retrofit_level":"near_zero","description":"在低 C/N 情景下调整外加碳源的投加点和投加量。"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"parameter_front_position","type":"DesignParameter","properties":{"name":"锋面位置","symbol":"x_front","value_status":"unknown","verification_status":"unverified","description":"由负荷、C/N、温度与控制状态共同决定的氧化还原边界位置。"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"parameter_front_sharpness","type":"DesignParameter","properties":{"name":"过渡带厚度","symbol":"front_sharpness","value_status":"literature_range","verification_status":"unverified","description":"以 bulk DO 等控制量表征分立分区与 SND 微区共存之间的连续状态；0.3–0.5 mg/L 仅为待验证起始范围。","unit":"mg/L bulk DO"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"parameter_front_migration_rate_max","type":"DesignParameter","properties":{"name":"锋面最大迁移速度","symbol":"v_front_max","value_status":"unknown","verification_status":"unverified","description":"受硝化活性空间再分布等慢过程约束的最大重配速度。"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"parameter_reconfiguration_time_constant","type":"DesignParameter","properties":{"name":"重配响应时间常数","symbol":"tau_reconfig","value_status":"unknown","verification_status":"unverified","description":"控制分区重配相对负荷变化的响应速度和阻尼。"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"constraint_true_anaerobic_contact","type":"EngineeringConstraint","properties":{"name":"保持真正厌氧接触","severity":"exclude_if_violated","description":"生物除磷要求进水先与回流污泥在无氧和无硝酸盐条件下接触。"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"constraint_nitrifier_srt","type":"EngineeringConstraint","properties":{"name":"保持硝化菌所需 SRT 与稳定好氧环境","severity":"exclude_if_violated","description":"分区重配不得破坏慢生长硝化菌的污泥龄和必要好氧容量。"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"constraint_no_nitrate_to_anaerobic","type":"EngineeringConstraint","properties":{"name":"避免硝酸盐回流至厌氧区","severity":"exclude_if_violated","description":"回流路由必须防止硝酸盐破坏厌氧释磷条件。"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"module_redox_stratified_community","type":"DesignModule","properties":{"name":"氧化还原分层微生物群落模块","layer":"microbial","summary":"按功能区与电子受体梯度组织群落；尚未给出菌种配方或工程验证。","editable_variables":["functional_guild_ratio","spatial_retention","srt"],"verification_status":"unverified"},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"module_segmented_a2o_reactor","type":"DesignModule","properties":{"name":"可独立曝气的串联分区 A²/O 反应器模块","layer":"reactor","summary":"将生化段离散为可独立曝气并可切换功能的串联区段。","editable_variables":["zone_count","zone_volume","aeration_grid","recycle_takeoff","recycle_return"],"verification_status":"unverified"},"source":"docs/2026-06-10-vertical-slice-a2o-implementation-plan.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"module_adaptive_redox_controller","type":"DesignModule","properties":{"name":"自适应氧化还原锋面控制模块","layer":"control","summary":"依据进出水和区段状态，受约束地调整曝气、回流与可选碳源投加。","editable_variables":["front_position_setpoint","front_sharpness","front_migration_rate_limit","minimum_dwell_time"],"verification_status":"unverified"},"source":"docs/2026-06-10-vertical-slice-a2o-implementation-plan.md","ts":"2026-08-13T00:00:00+08:00"}
{"op":"create","id":"assembly_adaptive_a2o_reactor","type":"AssemblyPattern","properties":{"name":"自适应分区仿生 A²/O 反应器装配模式","summary":"把功能分层群落、可重配串联反应区和受约束控制器组合为整机候选；当前是待仿真验证的设计模式，不是成熟方案。","verification_status":"unverified","interfaces":["microbial_state_to_reactor_zone","sensor_state_to_controller","controller_to_aeration_and_recycle_actuators"]},"source":"docs/2026-06-10-vertical-slice-a2o-spec.md","ts":"2026-08-13T00:00:00+08:00"}
