        {
          "parameter": "吸附机理",
          "value": "水介导的吸附机制",
          "ref_doi": "10.1002/smll.201201125"
        },
        {
          "parameter": "吸附机理 - 静电作用",
          "value": "硫丹分子富含氯原子，形成密集电子云，与精氨酸单体（ArMA）上在生理pH下带正电荷的胺基（NH2+ 和 NH3+）发生静电相互作用。",
          "ref_doi": "10.1007/s11356-018-2531-z"
        }
      ]
    },
    {
      "mechanism": "疏水",
      "evidence_count": 5,
      "key_references": [
        "10.20450/mjcce.2018.1442",
