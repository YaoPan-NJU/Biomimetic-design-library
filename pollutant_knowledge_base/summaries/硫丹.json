        "10.1061/ASCEEE.1943-7870.0000246",
        "10.5004/dwt.2021.26698"
      ],
      "details": [
        {
          "parameter": "吸附机理 - 醇憎作用",
          "value": "乙醇分子部分带正电荷的CH3-CH2-区域被ArMA分子上的正电荷基团排斥，乙醇分子的-OH区域被硫丹富电子端排斥，导致乙醇分子被从吸附位点推开，类似于疏水作用。",
          "ref_doi": "10.1007/s11356-018-2531-z"
        },
        {
          "parameter": "竞争吸附优先顺序与主导机理",
          "value": "吸附顺序: endosulfan > atrazine > monocrotophos; 主导机理为疏水作用",
          "ref_doi": "10.1061/ASCEEE.1943-7870.0000246"
        },
        {
          "parameter": "ACP-C6H5吸附机理 adsorption mechanism of ACP-C6H5",
          "value": "π-π堆积和疏水作用 π-π stacking and hydrophobic interactions",
          "ref_doi": "10.20450/mjcce.2018.1442"
        }
      ]
    },
